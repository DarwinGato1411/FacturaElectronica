        div.z-menubar-hor .z-menuitem-body-over .z-menuitem-inner-r,
        div.z-menubar-hor .z-menuitem-body-seld .z-menuitem-inner-l,
        div.z-menubar-hor .z-menuitem-body-seld .z-menuitem-inner-m,
        div.z-menubar-hor .z-menuitem-body-seld .z-menuitem-inner-r,
        div.z-menubar-hor .z-menuitem-body-over .z-menuitem-inner-m .z-menuitem-btn,
