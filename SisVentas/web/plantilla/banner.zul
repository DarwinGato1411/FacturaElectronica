            background-image: none !important;
            border: 0 none !important;
            color: #122536 !important;
        }
        .banner .z-menubar-left,
        .banner .z-menubar-right,
        .banner .z-menubar-scroll,
        div.z-menubar-hor .z-menubar-left,
